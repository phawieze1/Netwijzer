{
  "$comment": "Netwijzer design tokens. Bron: docs/01-identiteit.md. tokens.css is de CSS-vertaling hiervan.",
  "color": {
    "light": {
      "paper": "#F2F3EF", "paper-2": "#E7E9E3", "ink": "#121A24", "ink-2": "#55606C", "rule": "#CBCFC7", "needle": "#D2302A",
      "sun": "#D99A0B", "verbruik": "#3D5AA8", "wind": "#2B7B88", "geo": "#6E7F3C"
    },
    "dark": {
      "paper": "#0E1318", "paper-2": "#161E26", "ink": "#E7E9E4", "ink-2": "#9AA4AE", "rule": "#2A3440", "needle": "#FF5B4F",
      "sun": "#F0B431", "verbruik": "#8CA4EA", "wind": "#4FB0C0", "geo": "#AFC274"
    }
  },
  "theme": {
    "opwek": "sun",
    "verbruik": "verbruik",
    "net": "needle",
    "markt": "wind",
    "geo": "geo"
  },
  "landscape": {
    "$comment": "Vast palet voor de hero; wisselt niet met licht/donker. RGB.",
    "dayTop": [176, 205, 218], "dayBottom": [236, 239, 230],
    "nightTop": [14, 22, 36], "nightBottom": [40, 56, 74], "dusk": [236, 176, 128],
    "land": [36, 48, 42], "landNight": [12, 18, 22],
    "water": [46, 78, 88], "waterNight": [16, 28, 36],
    "sun": [233, 162, 28], "window": [242, 193, 78],
    "mill": [30, 42, 48], "millNight": [176, 188, 194],
    "mist": [226, 231, 231], "playhead": [210, 48, 42]
  },
  "font": {
    "display": { "family": "Source Serif 4", "weights": [400, 600, 700], "italic": true },
    "body": { "family": "Schibsted Grotesk", "weights": [400, 500, 600] },
    "data": { "family": "Azeret Mono", "weights": [400, 500] }
  },
  "size": {
    "step--1": "0.8125rem", "step-0": "1rem", "step-1": "1.125rem", "step-2": "1.5rem",
    "step-3": "clamp(1.8rem, 3vw, 2.4rem)", "step-4": "clamp(2.2rem, 4.4vw, 3.5rem)"
  },
  "space": { "max": "1240px", "gutter": "clamp(16px, 4vw, 48px)", "section": "88px" },
  "radius": { "default": "6px", "pill": "999px" },
  "motion": { "easeOut": "cubic-bezier(.2,.7,.2,1)", "logoCycle": "6s", "heroLoop": "36s" },
  "format": { "locale": "nl-NL", "decimal": ",", "date": "d MMM yyyy", "time": "HH:mm" }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netwijzer.example/schemas/dataset.schema.json",
  "title": "dataset",
  "description": "Een dataset in de catalogus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "naam",
    "leverancier",
    "thema",
    "beschrijving",
    "frequentie",
    "formaat",
    "toegang",
    "sinds",
    "bronUrl",
    "zekerheid"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "naam": {
      "type": "string",
      "maxLength": 90
    },
    "leverancier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "slug van een bron in content/bronnen"
    },
    "thema": {
      "type": "string",
      "enum": [
        "opwek",
        "verbruik",
        "net",
        "markt",
        "geo"
      ]
    },
    "beschrijving": {
      "type": "string",
      "maxLength": 400,
      "description": "Eigen woorden, 1-3 zinnen."
    },
    "frequentie": {
      "type": "string",
      "enum": [
        "minuut",
        "kwartier",
        "uur",
        "dag",
        "maand",
        "jaar",
        "statisch"
      ]
    },
    "frequentieLabel": {
      "type": "string",
      "description": "Optioneel, bv. 'per station'. Anders afgeleid van frequentie."
    },
    "formaat": {
      "type": "string",
      "enum": [
        "API",
        "Bestand",
        "Kaart"
      ]
    },
    "toegang": {
      "type": "string",
      "enum": [
        "open",
        "account"
      ]
    },
    "sinds": {
      "type": "integer",
      "minimum": 1990,
      "maximum": 2100
    },
    "eenheid": {
      "type": "string"
    },
    "laatstBijgewerkt": {
      "type": "string",
      "format": "date",
      "description": "Wanneer de bron de data voor het laatst bijwerkte."
    },
    "laatstGecontroleerd": {
      "type": "string",
      "format": "date-time",
      "description": "Laatste geslaagde controle door agent of script."
    },
    "bronUrl": {
      "type": "string",
      "format": "uri"
    },
    "documentatieUrl": {
      "type": "string",
      "format": "uri"
    },
    "licentie": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "naam"
      ],
      "properties": {
        "naam": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "velden": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "naam",
          "type",
          "betekenis"
        ],
        "properties": {
          "naam": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "betekenis": {
            "type": "string"
          }
        }
      }
    },
    "beperkingen": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "weergave": {
          "type": "string",
          "enum": [
            "weefsel",
            "staven",
            "punten"
          ]
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valkuilen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "zekerheid": {
      "type": "string",
      "enum": [
        "hoog",
        "midden",
        "laag"
      ]
    },
    "voorbeeld": {
      "type": "boolean",
      "description": "true = placeholder, wordt als voorbeeld getoond."
    }
  }
}
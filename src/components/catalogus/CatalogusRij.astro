---
/**
 * Eén rij in de lijstweergave van de catalogus (`.row` uit het prototype).
 *
 * De data-attributen komen uit `scripts/catalogus/velden.ts`, zodat het
 * filter-island en deze markup nooit uit elkaar lopen.
 */

import { datum, frequentieLabel } from '../../lib/format.ts';
import type { Dataset } from '../../lib/inhoud.ts';
import { paden } from '../../lib/paden.ts';
import { themaNaam } from '../../lib/themas.ts';
import { itemAttributen } from '../../scripts/catalogus/velden.ts';
import Themalabel from './Themalabel.astro';
import Toegangbadge from './Toegangbadge.astro';
import Tijdbalk from './Tijdbalk.astro';

interface Props {
  dataset: Dataset;
  /** Weergavenaam van de leverancier, niet de slug. */
  bronnaam: string;
  van: number;
  tot: number;
}

const { dataset, bronnaam, van, tot } = Astro.props;
const d = dataset.data;

const attributen = itemAttributen({
  slug: d.slug,
  naam: d.naam,
  bronnaam,
  thema: d.thema,
  themaNaam: themaNaam(d.thema),
  formaat: d.formaat,
  toegang: d.toegang,
  frequentie: d.frequentie,
});
---

<a class="row" href={paden.dataset(d.slug)} {...attributen}>
  <span class="nm">
    <b>{d.naam}</b>
    <span>{bronnaam}</span>
  </span>
  <Themalabel thema={d.thema} />
  <span class="cell">
    {frequentieLabel(d.frequentie, d.frequentieLabel)}
    {d.laatstBijgewerkt !== undefined && <small>bijgewerkt {datum(d.laatstBijgewerkt)}</small>}
  </span>
  <span class="cell"><span class="badge">{d.formaat}</span></span>
  <span class="cell"><Toegangbadge toegang={d.toegang} /></span>
  <span class="tlc"><Tijdbalk sinds={d.sinds} van={van} tot={tot} thema={d.thema} /></span>
</a>
